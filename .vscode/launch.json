{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // Usage: open a Windows Explorer window, start debug,
        // select the Explorer process
        {
            "name": "Attach to Explorer",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Register",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "sudo",
            "args": ["regsvr32", "ADSExplorer.dll"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\Active",
            "environment": [],
            "console": "internalConsole",
            "preLaunchTask": "Build"
        },
        {
            "name": "Unregister",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "sudo",
            "args": ["regsvr32", "/u", "ADSExplorer.dll"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\Active",
            "environment": [],
            "console": "internalConsole",
            "preLaunchTask": "Build"
        },
    ]
}
