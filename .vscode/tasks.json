{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and reinstall",
            "command": "./Scripts/buildandreinstall.ps1",
            "type": "shell",
            "options": {
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-File"
                    ]
                },
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile",
                "$msvc"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build",
            "command": "./Scripts/build.ps1",
            "type": "shell",
            "options": {
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-File"
                    ]
                },
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile",
                "$msvc"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "./Scripts/clean.ps1",
            "options": {
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-File"
                    ]
                },
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile",
                "$msvc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Uninstall",
            "type": "shell",
            "command": "./Scripts/uninstall.ps1",
            "options": {
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-File"
                    ]
                },
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": {
                "kind": "none",
                "isDefault": false
            }
        },
        {
            "label": "Restart Explorer",
            "type": "shell",
            "command": "./Scripts/restartexplorer.ps1",
            "options": {
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-File"
                    ]
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
